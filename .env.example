# .env.example: NAMES ONLY. Never put real values in this file.
# Copy it to .env (which Git ignores) and fill in values there.
# The same names are set in GitHub > Settings > Environments.

# App
APP_ENV=
APP_URL=

# Database (Neon Postgres) - Week 5
DATABASE_URL=

# Sessions - Week 6
SESSION_SECRET=

# Cloudflare Turnstile (server key) - Week 6
TURNSTILE_SECRET_KEY=

# Stripe (sandbox / test mode only) - optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
